# ── Dependencies ──────────────────────────────
node_modules/

# ── Next.js build output ──────────────────────
.next/
out/
dist/
build/

# ── Environment variables ──────────────────────
.env
.env.local
.env*.local
.env.production
.env.development

# ── TypeScript cache ──────────────────────────
tsconfig.tsbuildinfo
*.tsbuildinfo

# ── Debug logs ────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS generated files ────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor folders ────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── User uploaded files (save to cloud storage on production) ──
public/uploads/*
!public/uploads/.gitkeep

