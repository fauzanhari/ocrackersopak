# ──────────────────────────────────────────────────────
# O-Crackers — Environment Variables Example
# Copy file ini menjadi .env dan isi dengan nilai asli
# ──────────────────────────────────────────────────────

# Database (Neon PostgreSQL)
# DATABASE_URL  = Pooled connection (untuk app / Prisma ORM)
# DIRECT_URL    = Direct connection (untuk prisma migrate / prisma studio)
# Keduanya bisa didapat dari dashboard Neon → Connection Details
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret — ganti dengan string acak panjang (min 32 karakter)
JWT_SECRET="ganti_dengan_string_acak_sangat_panjang_dan_rahasia_minimal_32_char"
